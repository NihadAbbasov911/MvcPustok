@using MVCClassTask.Areas.Admin.ViewModels.Product
@model ProductDetailVM

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">

            <div class="row g-4">
                
                <div class="col-md-4 text-center">
                    <img src="~/assets/images/products/@Model.ImageUrl"
                         class="img-fluid rounded-3 shadow-sm"
                         alt="@Model.Name" />
                </div>

               
                <div class="col-md-8">
                    <h2 class="fw-bold mb-3">@Model.Name</h2>

                    <p class="text-muted mb-2">
                        <i class="bi bi-person"></i>
                        <strong>Author:</strong> @Model.Author
                    </p>

                    <p class="text-muted mb-2">
                        <i class="bi bi-tag"></i>
                        <strong>Category:</strong> @Model.CategoryName
                    </p>

                    <hr />

                    <div class="mb-3">
                        <span class="fs-4 fw-bold text-success">
                            @Model.Price AZN
                        </span>

                        @if (Model.OldPrice > 0)
                        {
                            <span class="text-decoration-line-through text-muted ms-2">
                                @Model.OldPrice AZN
                            </span>
                        }

                        @if (Model.Discount > 0)
                        {
                            <span class="badge bg-danger ms-2">
                                -@Model.Discount%
                            </span>
                        }
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>

                       
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
