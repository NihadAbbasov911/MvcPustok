@using MVCClassTask.Models
@{
    int count = 0;
}
<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Products</h1>

    <div class="card shadow mb-4">

        <div class="card shadow mb-4">

            <a asp-controller="category" asp-action="create" class="btn btn-success">Add Category</a>
            <div class="card-body">
                <div class="table-responsive">

                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>

        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (Category category in Model)
                        {
                            count++;
                            <tr>
                                <td class="py-1">@count</td>

                                <td>
                                    <img src="~/assets/image/bg-images/@category.Image"
                                         style="width:60px; height:60px; object-fit:cover; border-radius:6px;" />
                                </td>

                                <td>@category.Name</td>

                                <td class="text-center">
                                    <a asp-action="detail"
                                       asp-route-id="@category.Id"
                                       class="btn btn-primary"
                                       style="padding:8px 12px; border-radius:50%; margin-right:5px;">
                                        <i class="fas fa-eye" style="font-size:14px;"></i>
                                    </a>



                                                        <a asp-action="edit"
                                                           asp-route-id="@category.Id"
                                                           class="btn btn-warning"
                                                           style="padding:8px 12px; border-radius:50%; margin-right:5px;">
                                                            <i class="fas fa-edit" style="font-size:14px;"></i>
                                                        </a>
                                                        <a asp-action="delete"
                                                           asp-route-id="@category.Id"
                                                           class="btn btn-danger"
                                                           style="padding:8px 12px; border-radius:50%; margin-right:5px;">
                                                            <i class="fas fa-trash" style="font-size:14px;"></i>
                                                        </a>
                                    
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
