@using MVCClassTask.Models
@model MVCClassTask.Areas.Admin.ViewModels.Category.CategoryWithProductVM

<div class="card mx-auto"
     style="max-width: 23rem; border: none; border-radius: 18px; box-shadow: 0 15px 35px rgba(0,0,0,.12); transition: .3s;"
     onmouseover="this.style.transform='translateY(-6px)'"
     onmouseout="this.style.transform='translateY(0)'">

    <div class="card-body p-4">
        <!-- Header -->
        <div style="background: linear-gradient(135deg,#0d6efd,#6610f2); border-radius: 14px; padding: 16px; margin-bottom: 20px;">
            <h5 style="color:white;font-weight:700;margin-bottom:4px;">DETAIL CATEGORY</h5>
            <small style="color:rgba(255,255,255,.75);">Category Information</small>
        </div>

        <!-- ID -->
        <div style="display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px dashed #ddd;">
            <span style="color:#0d6efd;font-weight:600;">ID</span>
            <span class="badge bg-primary ms-auto">@Model.Id</span>
        </div>

        <!-- Name -->
        <div style="display:flex; align-items:center; gap:10px; padding:12px 0; border-bottom:1px dashed #ddd;">
            <span style="color:#198754;font-weight:600;">Name</span>
            <span style="margin-left:auto;font-weight:600;">@Model.Name</span>
        </div>

        <!-- Products Header -->
        <div class="mt-3 mb-2">
            <h6>Products in this Category (@Model.Products.Count)</h6>
        </div>

        <!-- Products Cards -->
        <div class="row">
            @foreach (var product in Model.Products)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="~/assets/images/products/@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:150px; object-fit:cover;">
                        <div class="card-body">
                            <h6 class="card-title">@product.Name</h6>
                            <p class="card-text">Price: $@product.Price</p>
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="btn btn-primary btn-sm">Detail</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Back Button -->
        <div class="text-end mt-4">
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>

    </div>
</div>
